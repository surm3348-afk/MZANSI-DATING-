rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // Real-time Typing Status tracking
    match /typing_status/{statusId} {
      allow read, write: if true;
    }

    // Chat messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Registered FCM Device Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Real-time Push Notifications (Messages, Likes, Superlikes)
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
